<?xml version="1.0" encoding="UTF-8"?>
<!-- 根标签：Spring IoC容器的入口 -->
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans 
       http://www.springframework.org/schema/beans/spring-beans.xsd
       ">

    <!-- 此处配置Bean、依赖注入等内容 -->
<!--    1单例-->
<!--    <bean id="onebean" scope="singleton" class="a9one.One"/>-->
<!--    2多例-->
<!--    <bean id="onebean" scope="prototype" class="a9one.One"/>-->
<!--    3-->
    <bean class="org.springframework.beans.factory.config.CustomScopeConfigurer">
        <property name="scopes">
            <map>
                <!-- 键：作用域名称，值：作用域实现类 -->
                <entry key="thread" value-ref="threadScope"/>
            </map>
        </property>
    </bean>
    <bean id="threadScope" class="org.springframework.context.support.SimpleThreadScope"/>

    <bean id="onebean" scope="thread" class="a9one.One"/>
</beans>