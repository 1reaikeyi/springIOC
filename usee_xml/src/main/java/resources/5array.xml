<!--    </bean>-->
        <bean id="arrayBean3" class="a5array.array">
            <constructor-arg name="array" >
                   <array>
                       <value>eat</value>
                       <value>sleep</value>
                       <value>play</value>
                   </array>
            </constructor-arg>
        </bean>

</beans>