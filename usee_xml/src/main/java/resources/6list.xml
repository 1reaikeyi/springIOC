<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
   <bean id = "listBean" class="a6list.list">
        <property name="name">
            <list>
                <value>one</value>
                <value>two</value>
                <value>three</value>
            </list>
        </property>
   </bean>
    <bean id = "listBean2" class="a6list.list">
        <property name="phone">
            <set>
                <value>one</value>
                <value>two</value>
                <value>two</value>
                <value>three</value>
            </set>
        </property>
    </bean>
    <bean id = "listBean3" class="a6list.list">
        <property name="eat">
            <map>
                <entry key="one" value="first"></entry>
                <entry key="two" value="second"></entry>
                <entry key="three" value="third"></entry>
            </map>
        </property>
    </bean>
    <bean id="listBean4" class="a6list.list">
        <property name="properties">
            <props>
                <prop key="10000">first</prop>
                <prop key="20000">first</prop>
                <prop key="30000">first</prop>
            </props>

        </property>
    </bean>
</beans>