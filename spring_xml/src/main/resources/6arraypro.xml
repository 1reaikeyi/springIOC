            <set>
                <value>one</value>
                <value>two</value>
                <value>two</value>
                <value>three</value>
            </set>
        </property>
    </bean>
    <bean id = "listBean3" class="a6arraypro.Arraypro">
        <property name="eat">
            <map>
                <entry key="one" value="first"></entry>
                <entry key="two" value="second"></entry>
                <entry key="three" value="third"></entry>
