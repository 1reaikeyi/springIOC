<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.Dao">

    <!-- 查询所有用户 -->
    <insert id="insert">
        insert into ajbdc(name,money) values (#{name},#{money});
    </insert>
    <update id="update">
        update ajbdc set name=#{name},money=#{money} where id=#{id};
    </update>
    <delete id="delete">
        delete from ajbdc where id=#{id};
    </delete>
    <select id="selectById" resultType="Account">
        select * from ajbdc where id=#{id};
    </select>
    <select id="selectAll" resultType="Account">
        select * from ajbdc;
    </select>



</mapper>