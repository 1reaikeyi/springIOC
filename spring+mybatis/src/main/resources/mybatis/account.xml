<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="bmybatis.Dao">


    <insert id="insert">
        insert into account(name,money) values (#{accountant},#{money});
    </insert>
    <update id="update">
        update account set money=#{money} where name=#{accountant};
    </update>
    <delete id="delete">
        delete from account where name=#{accountant};
    </delete>
    <select id="selectById" resultType="bmybatis.Account">
        select money, name as accountant from account where name = #{accountant};
    </select>
    <select id="selectAll" resultType="bmybatis.Account">
        select money, name as accountant from account;
    </select>



</mapper>