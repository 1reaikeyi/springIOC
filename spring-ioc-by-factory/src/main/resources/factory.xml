<?xml version="1.0" encoding="UTF-8"?>
<!-- 根标签：Spring IoC容器的入口 -->
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       ">

    <!-- 此处配置Bean、依赖注入等内容 -->
    <bean id="bean" class="factory.A"/>

<!--    静态-->
    <bean id="beanstatic" class="factory.AFactory" factory-method="a"/>
<!--    实例-->
    <bean id="factory" class="factory.AFactory"/>
    <bean id="beandynamic" factory-bean="factory" factory-method="getA"/>

    <bean id="factoryA" class="factory.AFactoryBean"/>

</beans>