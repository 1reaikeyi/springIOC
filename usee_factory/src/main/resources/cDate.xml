<?xml version="1.0" encoding="UTF-8"?>
<!-- 根标签：Spring IoC容器的入口 -->
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       ">
<!--    1-->
        <bean id="time" class="cDate.StuFActory">
            <constructor-arg value="2021-01-01"/>
        </bean>
<!--    2-->
    <bean id="stu1" class="cDate.Stu" >
        <property name="bir" ref="time"/>
    </bean>
    <bean id="stu2" class="cDate.Stu" >
        <property name="bir" value="Fri Oct 10 21:34:43 CST 2025"/>
    </bean>

</beans>